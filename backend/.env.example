# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qr_print

# ---- Session ----
SESSION_SECRET=change-me-to-a-random-string

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ---- Job settings ----
POLL_INTERVAL_HINT_SEC=5
JOB_EXPIRY_MINUTES=30
RETENTION_DAYS=14

# ---- Default shop (created by seed script) ----
SHOP_NAME=My Print Shop
DASHBOARD_PASSWORD=admin123
